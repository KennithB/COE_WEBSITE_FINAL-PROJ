# Auto detect text files and perform LF normalization
* text=auto

# ==============================================================================
# GitHub Linguist Language Stats Override
# Purpose: Highlight JavaScript as the primary language on the repository
# ==============================================================================

# Force JavaScript to be detected and prioritized
*.js linguist-detectable=true
assets/js/** linguist-detectable=true

# Suppress CSS and HTML from language calculation
*.css linguist-detectable=false
assets/css/** linguist-detectable=false
*.html linguist-detectable=false
